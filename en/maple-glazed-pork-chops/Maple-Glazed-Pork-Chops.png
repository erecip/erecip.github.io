    font-weight: normal;
    font-style: normal;
}

/* PinBox */
.pinBox .pinBlock {
    background: #cb2027 !important;
    border-radius: 4px !important;
    color: #fff !important;
    padding: 16px !important;
    margin: 32px 0 !important;
    text-align: center !important;
}

.pinBox h3.title-box {
    color: #fff !important;
    font-family: "Soda Cream", Sans-serif;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    margin: 0 0 16px !important;
	  font-size: 35px;
    text-transform: inherit !important;
}


.pinBox a.shareButton.pinButton {
    background: #fff !important;
    color: #cb2027 !important;
    cursor: pointer !important;
    display: block !important;
    font-size: 35px !important;
    position: relative !important;
    width: 45% !important; /* Set width to 50% */
	margin: 0 auto !important; /* Center horizontally */
    border-radius: 20px !important;
    text-decoration: none !important;
}

.pin-icon {
    width: 52px !important;
    height: 52px !important;
    vertical-align: middle !important;
    margin-right: 10px !important;
}

span.countWrapper.hiddenState {
    transition: padding 0.1s linear 0s !important;
}

.iconContainer {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
}

.iconContent {
    display: flex !important;
    align-items: center !important;
}

.shareLabel {
    margin-left: 0px !important;
}

.pinBox a.shareButton.pinButton:hover {
    background: #cb2027 !important;
    color: #fff !important;
}    

.pinBox .pinDescription {
    font-family: "Muli", "Helvetica Neue", sans-serif !important;
